        "enum": [
          "Low",
          "Medium",
          "High",
          "Urgent"
        ],
        "type": "string"
      },
      "TaskStatusEnum": {
        "enum": [
          "ToDo",
          "InProgress",
          "Done"
        ],
        "type": "string"
      },
